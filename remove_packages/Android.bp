// GMS apps dropped so mini GApps fits in the super partition
cc_library_shared {
    name: "RemovePackages",
    overrides: [
        "KidsSupervisionStub",
        "MoseyApp",
        "talkback",
    ],
    compile_multilib: "64",
}
