<resources>
    <!-- The telephoto camera is camera 50 (stock cameradata/camera-feature.xml BACK_TELE_CAMERA_ID). -->
    <bool name="config_enableAuxCameras">true</bool>

    <!-- Stock records 1080p at 60 fps on the back camera
         (camera-feature.xml BACK_CAMCORDER_RESOLUTION_FEATURE_MAP_1920X1080_60FPS). -->
    <string-array name="config_additionalVideoConfigurations">
        <item>0</item> <item>fhd</item> <item>60</item>
    </string-array>
</resources>
